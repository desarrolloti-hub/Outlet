rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Regla abierta original de "modo de prueba".
    // Ya había expirado (estaba puesta hasta el 14 de junio de 2026).
    // La extiendo temporalmente para no romper el resto de tu app,
    // pero esto sigue dejando TODA tu base de datos abierta a cualquiera.
    // Antes de producción, reemplaza esto por reglas reales por colección
    // (clientes, administradores, productos, ventas, etc.)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }

    // ℹ️ Los tokens FCM YA NO se guardan en una colección aparte "fcmTokens".
    // Ahora viven dentro del propio documento del usuario, en el campo
    // `fcmTokens` (arreglo) de "clientes/{id}" o "administradores/{id}".
    // Cuando reemplaces la regla abierta de arriba por reglas reales,
    // asegúrate de permitir que cada usuario actualice SU PROPIO documento
    // (incluyendo el campo fcmTokens), por ejemplo:
    //
    // match /clientes/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    // match /administradores/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
