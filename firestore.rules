rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Regla abierta original de "modo de prueba".
    // Ya había expirado (estaba puesta hasta el 14 de junio de 2026).
    // La extiendo temporalmente para no romper el resto de tu app,
    // pero esto sigue dejando TODA tu base de datos abierta a cualquiera.
    // Antes de producción, reemplaza esto por reglas reales por colección
    // (clientes, administradores, productos, ventas, etc.)
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }

    // ✅ Regla específica y segura para los tokens FCM:
    // solo el propio usuario autenticado puede leer/escribir su documento de tokens.
    // Esta regla tiene prioridad sobre la de arriba para esta colección específica.
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
